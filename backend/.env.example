# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Database (SQLite file path - swap for Postgres DATABASE_URL in production)
DATABASE_STORAGE=./data/database.sqlite
# DATABASE_URL=postgres://user:password@host:5432/dbname

# LLM (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=15000

# Email (choose one provider - Nodemailer SMTP shown; swap transport for SendGrid/Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Healthcare Clinic <no-reply@clinic.com>"

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# Slot hold mechanism
SLOT_HOLD_TTL_SECONDS=300

# Background jobs
REMINDER_CRON="*/15 * * * *"
EMAIL_RETRY_CRON="*/10 * * * *"
MEDICATION_REMINDER_CRON="0 * * * *"
